---
import Layout from '../../layouts/Layout.astro';
import Menu from '../../components/Menu.astro';
import ProfilePanel from '../../components/ProfilePanel.astro';
import SkillsPanel from '../../components/SkillsPanel.astro';
import ProjectsPanel from '../../components/ProjectsPanel.astro';
import ContactPanel from '../../components/ContactPanel.astro';

const lang = 'pl';
const t = await import('../../i18n/pl.json');
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <Menu lang={lang} />
  <main>
    <ProfilePanel lang={lang} />
    <SkillsPanel lang={lang} />
    <ProjectsPanel lang={lang} />
    <ContactPanel lang={lang} />
  </main>
</Layout>
