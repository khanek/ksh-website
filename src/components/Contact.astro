---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
---

<section class="contact" id="contact">
  <div class="container">
    <span class="section-kicker">05 / {lang === 'pl' ? 'Bezpośredni kontakt' : 'Direct line'}</span>
    <div class="contact-layout">
      <div class="contact-heading">
      <h2>{t.contact.title}</h2>
        <p>{lang === 'pl' ? 'Masz trudny problem techniczny?' : 'Have a hard technical problem?'}</p>
      </div>
      <div class="contact-info">
        <a class="email-link" href={`mailto:${t.contact.email}`}>
          {t.contact.email}
          <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-item">
          <strong>{lang === 'pl' ? 'Telefon' : 'Phone'}</strong>
          <a href={`tel:${t.contact.phone.replace(/\s/g, '')}`}>{t.contact.phone}</a>
        </div>
        <div class="contact-item">
          <strong>{lang === 'pl' ? 'Lokalizacja' : 'Location'}</strong>
          <span>{t.contact.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-card-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(2rem, 7vw, 8rem);
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .contact-heading h2 {
    font-size: clamp(3.5rem, 8vw, 7rem);
  }

  .contact-heading p {
    max-width: 20rem;
    color: var(--color-text);
    font-size: 1.15rem;
  }
  
  .contact-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    border-top: 1px solid var(--color-border);
  }

  .email-link {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.2rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .email-link span {
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .email-link:hover span {
    transform: translate(4px, -4px);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }

  .contact-item + .contact-item {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  .contact-item strong {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  
  .contact-item a,
  .contact-item span {
    color: var(--color-text-secondary);
  }
  
  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .email-link {
      grid-column: 1 / -1;
    }
  }
  
  @media print {
    .contact {
      background-color: transparent;
      padding: 0.5cm 0;
    }
    
    .contact-info {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      margin-top: 0.5cm;
      font-size: 10pt;
    }
    
    .contact-item {
      flex-direction: column;
      gap: 0.1cm;
    }
    
    .contact-item strong {
      font-weight: 600;
    }
    
    .contact-item a,
    .contact-item span {
      color: #000;
    }
  }
</style>
