---
import Panel from './Panel.astro';
import RansomText from './RansomText.astro';
import Starburst from './Starburst.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);

const [emailUser, emailDomain] = t.contact.email.split('@');
const mailto = `mailto:${t.contact.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
const telephone = `tel:${t.contact.phone.replace(/\s/g, '')}`;
const mapUrl = 'https://www.openstreetmap.org/search?query=Pozna%C5%84%2C%20Poland';
---

<Panel id="contact" title={t.menu.contact} lang={lang} tone="black">
  <div class="card">
    <Starburst class="card__burst" points={16} seed={5} />
    <RansomText text={t.contact.cardTitle} palette="on-red" class="card__title" />
    <p class="card__intro">{t.contact.intro}</p>

    <ul class="card__lines">
      <li><a class="card__line display" href={mailto}>{emailUser}@<wbr /><span class="card__domain">{emailDomain}</span></a></li>
      <li><a class="card__line display" href={telephone}>{t.contact.phone}</a></li>
      <li>
        <a class="card__line display" href={mapUrl} target="_blank" rel="noopener noreferrer">{t.contact.location}</a>
      </li>
    </ul>

    <p
      class="card__clock"
      data-clock
      data-lang={lang}
      data-working={t.contact.clock.working}
      data-evening={t.contact.clock.evening}
      data-weekend={t.contact.clock.weekend}
    >
      <span class="card__time display"><time data-clock-time>CET</time> {t.contact.clock.place}</span>
      <span class="card__status" data-clock-status aria-live="polite">{t.contact.clock.fallback}</span>
    </p>

    <div class="card__actions">
      <a class="card__button card__button--primary display" href={mailto}>{t.contact.greeting}</a>
      <a class="card__button display" href="/Krystian_Hanek_resume.pdf" download>{t.print.download}</a>
    </div>

    <p class="card__signature display">{t.footer.wordmark}</p>
  </div>
</Panel>

<script>
  import { getPoznanTime, localeFor, POZNAN_TIME_ZONE } from '../scripts/poznan-time';

  const clock = document.querySelector<HTMLElement>('[data-clock]');

  function renderClock(element: HTMLElement) {
    const time = element.querySelector<HTMLTimeElement>('[data-clock-time]');
    const status = element.querySelector('[data-clock-status]');
    if (!time || !status) return;

    const now = new Date();
    const { weekday, hour } = getPoznanTime(now);
    const isWeekend = weekday === 'Sat' || weekday === 'Sun' || (weekday === 'Fri' && hour >= 17);
    const isWorking = !isWeekend && hour >= 8 && hour < 17;

    time.textContent = new Intl.DateTimeFormat(localeFor(element.dataset.lang), {
      timeZone: POZNAN_TIME_ZONE,
      hour: '2-digit',
      minute: '2-digit',
    }).format(now);
    time.dateTime = now.toISOString();
    status.textContent = (isWeekend ? element.dataset.weekend : isWorking ? element.dataset.working : element.dataset.evening) ?? '';
  }

  if (clock) {
    renderClock(clock);
    window.setInterval(() => renderClock(clock), 15_000);
  }
</script>

<style>
  .card {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 5vw, 4.5rem);
    color: var(--p5-white);
    background: var(--p5-red);
    clip-path: polygon(0 2%, 98% 0, 100% 97%, 3% 100%);
    rotate: -1.5deg;
    isolation: isolate;
  }

  .card :global(.card__burst) {
    position: absolute;
    top: -5rem;
    right: -5rem;
    z-index: -1;
    width: clamp(14rem, 28vw, 24rem);
    color: var(--p5-black);
    animation: card-burst 50s linear infinite;
  }

  @keyframes card-burst {
    to {
      rotate: 360deg;
    }
  }

  .card :global(.card__title) {
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    rotate: -3deg;
  }

  .card__intro {
    max-width: 30ch;
    margin-top: 1.75rem;
    font-size: var(--step-lead);
    font-weight: 800;
    line-height: 1.3;
  }

  .card__lines {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .card__line {
    position: relative;
    display: inline-block;
    padding: 0.04em 0.2em 0;
    font-size: clamp(1.9rem, 1rem + 3vw, 3.75rem);
    text-decoration: none;
    overflow-wrap: anywhere;
    hyphens: none;
    isolation: isolate;
  }

  .card__domain {
    white-space: nowrap;
  }

  .card__line::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--p5-black);
    clip-path: var(--slab);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-snap) var(--ease-snap);
  }

  .card__line:hover::before,
  .card__line:focus-visible::before {
    transform: scaleX(1);
  }

  .card__clock {
    display: grid;
    gap: 0.25rem;
    margin-top: 2rem;
  }

  .card__time {
    font-size: 1.75rem;
  }

  .card__time time {
    font-variant-numeric: tabular-nums;
  }

  .card__status {
    font-weight: 600;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .card__button {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.2em 1em 0.1em;
    font-size: 1.6rem;
    text-decoration: none;
    color: var(--p5-black);
    background: var(--p5-white);
    clip-path: var(--slab);
    transition: rotate var(--t-snap) var(--ease-snap), scale var(--t-snap) var(--ease-snap);
  }

  .card__button--primary {
    color: var(--p5-white);
    background: var(--p5-black);
  }

  .card__button:hover,
  .card__button:focus-visible {
    rotate: -4deg;
    scale: 1.06;
  }

  .card__button:active {
    scale: 0.97;
  }

  .card__signature {
    margin-top: 3rem;
    text-align: right;
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    rotate: -4deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .card :global(.card__burst) {
      animation: none;
    }
  }
</style>
