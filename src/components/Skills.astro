---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
---

<section class="skills" id="skills">
  <div class="container">
    <header class="skills-heading">
      <span class="section-kicker">04 / {lang === 'pl' ? 'Narzędzia' : 'Toolkit'}</span>
      <h2 class="skills-title">{t.skills.title}</h2>
      <p>{lang === 'pl' ? 'Technologie dobieram do problemu — nie odwrotnie.' : 'Technology follows the problem—not the other way around.'}</p>
    </header>
    <div class="roadmap-tree">
      <div class="tree-branches">
        {t.skills.categories.map((category, categoryIndex) => (
          <div class="tree-branch" data-branch={categoryIndex}>
            <div class="branch-category">
              <div class="category-node">{category.title}</div>
            </div>
            <div class="branch-items">
              {category.items.map((item, itemIndex) => (
                <div 
                  class={`skill-item ${item.status === 'known' ? 'skill-known' : 'skill-learning'}`}
                  data-item={itemIndex}
                >
                  <span class="skill-name">{item.name}</span>
                  {item.status === 'learning' && (
                    <span class="learning-badge">{lang === 'pl' ? 'rozwijam' : 'learning'}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    background-color: var(--color-accent-strong);
    color: var(--color-accent-contrast);
  }

  .skills :global(.section-kicker) {
    color: var(--color-accent-contrast);
    opacity: 0.65;
  }

  .skills-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    align-items: end;
  }

  .skills-title {
    margin: 0;
    color: var(--color-accent-contrast);
    font-size: clamp(3rem, 7vw, 6.5rem);
  }

  .skills-heading p {
    grid-column: 2;
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--color-accent-contrast);
    font-size: 1.1rem;
    opacity: 0.72;
  }
  
  .roadmap-tree {
    position: relative;
  }
  
  .tree-branches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid color-mix(in srgb, var(--color-accent-contrast) 28%, transparent);
    border-left: 1px solid color-mix(in srgb, var(--color-accent-contrast) 28%, transparent);
    position: relative;
  }
  
  .tree-branch {
    position: relative;
    min-height: 240px;
    padding: 1.5rem;
    border-right: 1px solid color-mix(in srgb, var(--color-accent-contrast) 28%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-contrast) 28%, transparent);
  }
  
  .branch-category {
    margin-bottom: 1.5rem;
    position: relative;
  }

  .category-node {
    color: var(--color-accent-contrast);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  
  .branch-items {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    position: relative;
  }
  
  .skill-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0;
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.72;
    position: relative;
  }

  .skill-item::before {
    content: "→";
    opacity: 0.45;
  }

  .skill-item:hover {
    opacity: 1;
  }
  
  .learning-badge {
    padding: 0.12rem 0.3rem;
    color: var(--color-accent-strong);
    background: var(--color-accent-contrast);
    font-size: 0.58rem;
    text-transform: lowercase;
  }
  
  @media (max-width: 900px) {
    .tree-branches {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .skills-heading {
      grid-template-columns: 1fr;
    }

    .skills-heading p {
      grid-column: auto;
    }

    .tree-branches {
      grid-template-columns: 1fr;
    }

    .tree-branch {
      min-height: auto;
    }
  }
  
  @media print {
    .skills {
      background-color: transparent;
      padding: 0.5cm 0;
    }
    
    .roadmap-tree {
      padding-top: 0.5cm;
    }
    
    .root-node {
      background: transparent;
      color: #000;
      border: 2pt solid #000;
      padding: 0.3cm 0.6cm;
      font-size: 14pt;
    }
    
    .tree-branch::before,
    .branch-category::before,
    .branch-items::before {
      display: none;
    }
    
    .category-node {
      background: transparent;
      border: 1pt solid #000;
      padding: 0.2cm 0.4cm;
      font-size: 11pt;
    }
    
    .skill-known {
      background: transparent;
      color: #000;
      border: 1pt solid #000;
      padding: 0.1cm 0.3cm;
    }
    
    .skill-learning {
      border-style: dashed;
      border-width: 1pt;
      padding: 0.1cm 0.3cm;
    }
    
    .learning-badge {
      display: none;
    }
  }
</style>
