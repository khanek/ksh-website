---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
---

<section class="about" id="about">
  <div class="container">
    <header class="section-heading">
      <span class="section-kicker">02 / {lang === 'pl' ? 'Profil' : 'Profile'}</span>
      <h2>{t.about.title}</h2>
      <p class="section-statement">
        {lang === 'pl' ? 'Buduję backendy, które wytrzymują kontakt z rzeczywistością.' : 'I build backends that hold up in the real world.'}
      </p>
    </header>
    <div class="experience-mark" aria-hidden="true">
      <span class="experience-number">10</span>
      <span class="experience-plus">+</span>
      <span class="experience-label">{lang === 'pl' ? 'lat praktyki' : 'years shipping'}</span>
    </div>
    <div class="about-content">
      <p>{t.about.content}</p>
      <p>{t.about.content2}</p>
    </div>
  </div>
</section>

<style>
  .about {
    border-block: 1px solid var(--color-border);
    background: var(--color-card-bg);
  }
  
  .about .container {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(170px, 0.45fr) minmax(320px, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .section-heading h2 {
    font-size: clamp(2.5rem, 5vw, 5rem);
  }

  .section-statement {
    max-width: 28rem;
    margin-top: var(--spacing-md);
    color: var(--color-text);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .experience-mark {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    padding-top: 0.25rem;
    color: var(--color-accent);
  }

  .experience-number {
    font-size: clamp(5.5rem, 10vw, 9rem);
    font-weight: 800;
    line-height: 0.75;
    letter-spacing: -0.1em;
  }

  .experience-plus {
    font-family: var(--font-mono);
    font-size: 1.5rem;
  }

  .experience-label {
    grid-column: 1 / -1;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-content p {
    margin-bottom: var(--spacing-md);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.75;
  }
  
  @media (max-width: 900px) {
    .about .container {
      grid-template-columns: 1fr 1fr;
    }

    .about-content {
      grid-column: 1 / -1;
      max-width: 720px;
    }
  }

  @media (max-width: 560px) {
    .about .container {
      grid-template-columns: 1fr;
    }

    .about-content {
      grid-column: auto;
    }
  }
  
  @media print {
    .about {
      padding: 0.5cm 0;
    }
    
    .about .container {
      display: block;
      gap: 0.5cm;
    }

    .experience-mark {
      display: none;
    }
    
    .about-content p {
      margin-bottom: 0.4cm;
      font-size: 11pt;
    }
  }
</style>
