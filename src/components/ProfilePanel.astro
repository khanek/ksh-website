---
import Panel from './Panel.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
const firstName = t.hero.name.split(' ')[0];
const rankPips = Array.from({ length: 10 });
---

<Panel id="profile" title={t.menu.profile} lang={lang} tone="white">
  <div class="profile">
    <div class="confidant">
      <p class="confidant__arcana display">{t.profile.arcana}</p>
      <p class="confidant__name display">{t.hero.name}</p>
      <p class="confidant__role">{t.hero.title}</p>
      <dl class="confidant__rank">
        <dt class="display">{t.profile.rankLabel}</dt>
        <dd>{t.profile.rankValue}</dd>
      </dl>
      <ol class="confidant__pips" aria-hidden="true">
        {rankPips.map((_, index) => <li style={`--pip:${index}`} />)}
      </ol>
    </div>

    <div class="dialogue">
      <p class="dialogue__speaker display">{firstName}</p>
      <div class="dialogue__box">
        <p>{t.about.content}</p>
        <p>{t.about.content2}</p>
      </div>
      <ul class="facts">
        {t.about.facts.map((fact: string) => <li>{fact}</li>)}
      </ul>
    </div>
  </div>
</Panel>

<style>
  .profile {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }

  .confidant {
    grid-column: 1 / span 5;
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--p5-white);
    background: var(--p5-black);
    clip-path: polygon(0 3%, 100% 0, 96% 100%, 3% 97%);
    rotate: -2deg;
  }

  .confidant__arcana {
    display: inline-block;
    padding: 0.1em 0.35em 0.04em;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.25rem);
    background: var(--p5-red);
    clip-path: var(--slab-alt);
    rotate: -4deg;
  }

  .confidant__name {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.75rem);
  }

  .confidant__role {
    margin-top: 0.5rem;
    font-size: var(--step-lead);
    font-weight: 800;
    font-style: italic;
  }

  .confidant__rank {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .confidant__rank dt {
    font-size: 1.75rem;
    color: var(--p5-red);
  }

  .confidant__rank dd {
    font-weight: 600;
  }

  .confidant__pips {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .confidant__pips li {
    flex: 1;
    height: 1.1rem;
    background: var(--p5-red);
    clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%);
    animation: pip-fill 380ms var(--ease-snap) both;
  }

  .confidant__pips li {
    animation-delay: calc(300ms + var(--pip) * 50ms);
  }

  @keyframes pip-fill {
    from {
      scale: 0 1;
    }
  }

  .dialogue {
    grid-column: 7 / -1;
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .dialogue__speaker {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-left: 1.5rem;
    margin-bottom: -0.6rem;
    padding: 0.1em 0.6em 0.04em;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    color: var(--p5-white);
    background: var(--p5-red);
    clip-path: var(--slab);
    rotate: -5deg;
  }

  .dialogue__box {
    display: grid;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--step-lead);
    font-weight: 600;
    line-height: 1.4;
    color: var(--p5-white);
    background: var(--p5-black);
    clip-path: polygon(0 0, 100% 4%, 98% 100%, 2% 94%);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .facts li {
    padding: 0.4em 0.9em;
    font-weight: 800;
    color: var(--p5-white);
    background: var(--p5-red);
    clip-path: var(--slab-alt);
  }

  .facts li:nth-child(even) {
    color: var(--p5-black);
    background: var(--p5-white);
    box-shadow: inset 0 0 0 3px var(--p5-black); /* taste-skill-ignore: cut-paper outline, part of the P5 look */
  }

  @media (max-width: 900px) {
    .confidant,
    .dialogue {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .confidant__pips li {
      animation: none;
    }
  }
</style>
