---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-copy">
        <span class="hero-kicker">01 / {t.hero.title}</span>
        <h1 class="hero-name">{t.hero.name}</h1>
        <p class="hero-subtitle">{t.hero.subtitle}</p>
        <a href="#contact" class="hero-cta">
          {t.hero.cta}
          <span aria-hidden="true">↘</span>
        </a>
      </div>
      <div class="system-map" aria-hidden="true">
        <div class="map-label map-label-top">{lang === 'pl' ? 'SYSTEMY / CHMURA / SKALA' : 'SYSTEMS / CLOUD / SCALE'}</div>
        <div class="orbit orbit-outer"></div>
        <div class="orbit orbit-inner"></div>
        <div class="system-core">
          <span>10+</span>
          <small>{lang === 'pl' ? 'lat na' : 'years in'}<br />{lang === 'pl' ? 'produkcji' : 'production'}</small>
        </div>
        <span class="node node-a"></span>
        <span class="node node-b"></span>
        <span class="node node-c"></span>
        <div class="map-label map-label-bottom">
          <span>POZNAŃ, PL</span>
          <span>52.4064° N</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(4rem, 9vw, 8rem);
    align-items: center;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    width: min(60vw, 850px);
    aspect-ratio: 1;
    right: -18vw;
    top: 50%;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    transform: translateY(-50%);
    box-shadow: 0 0 0 11vw color-mix(in srgb, var(--color-surface) 35%, transparent);
    pointer-events: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    display: block;
    margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  
  .hero-name {
    max-width: 9ch;
    margin-bottom: var(--spacing-md);
    font-size: clamp(4.2rem, 10vw, 9rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.085em;
    animation: enter 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-subtitle {
    max-width: 600px;
    margin: 0 0 var(--spacing-md);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    line-height: 1.55;
    animation: enter 0.8s 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 2.75rem;
    min-width: 210px;
    margin-top: var(--spacing-sm);
    padding: 1rem 1.1rem;
    justify-content: space-between;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: gap 0.25s ease, background-color 0.25s ease;
    animation: enter 0.8s 0.22s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  
  .hero-cta:hover {
    gap: 3.25rem;
    color: var(--color-accent-contrast);
    background: var(--color-accent-strong);
  }

  .system-map {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    max-width: 520px;
    justify-self: end;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card-bg) 68%, transparent);
    animation: enter 1s 0.18s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .system-map::before,
  .system-map::after {
    content: "";
    position: absolute;
    background: var(--color-border);
  }

  .system-map::before {
    width: 1px;
    inset-block: 0;
    left: 50%;
  }

  .system-map::after {
    height: 1px;
    inset-inline: 0;
    top: 50%;
  }

  .orbit {
    position: absolute;
    inset: 14%;
    border: 1px solid var(--color-border);
    border-radius: 50%;
  }

  .orbit-inner {
    inset: 29%;
    border-style: dashed;
    animation: rotate 25s linear infinite;
  }

  .system-core {
    position: absolute;
    inset: 36%;
    z-index: 2;
    display: grid;
    place-content: center;
    text-align: center;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-radius: 50%;
  }

  .system-core span {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .system-core small,
  .map-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .node {
    position: absolute;
    z-index: 3;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border: 3px solid var(--color-card-bg);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .node-a { top: 13%; left: 47%; }
  .node-b { right: 15%; bottom: 25%; }
  .node-c { bottom: 20%; left: 20%; }

  .map-label {
    position: absolute;
    z-index: 4;
    color: var(--color-text-secondary);
  }

  .map-label-top {
    top: 1rem;
    left: 1rem;
  }

  .map-label-bottom {
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 1rem;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes rotate {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-block: 4.5rem 5.5rem;
    }

    .hero::before {
      display: none;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .hero-name {
      font-size: clamp(4rem, 21vw, 6.5rem);
    }

    .system-map {
      width: min(100%, 430px);
      justify-self: center;
    }
  }
  
  @media print {
    .hero {
      padding: 0.5cm 0;
    }
    
    .hero-content h1 {
      font-size: 24pt;
      margin-bottom: 0.2cm;
    }
    
    .hero-content h2 {
      font-size: 14pt;
      margin-bottom: 0.3cm;
    }
    
    .hero-subtitle {
      font-size: 11pt;
      margin-bottom: 0.5cm;
    }
  }
</style>
