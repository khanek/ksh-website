---
import Panel from './Panel.astro';

interface Props {
  lang: string;
}

interface Project {
  name: string;
  url?: string;
  summary: string;
  description: string;
  highlights: string[];
  technologies: string[];
}

const { lang } = Astro.props;
const t = await import(`../i18n/${lang}.json`);
const projectKeys = ['dmw', 'saas', 'kandua', 'worldexpo', 'questpass', 'less'] as const;
const projects = projectKeys.map((key) => ({ key, ...(t.projects[key] as Project) }));
---

<Panel id="projects" title={t.menu.projects} lang={lang} tone="red">
  <p class="quests__remark">{t.projects.remark}</p>

  <div class="quests" data-quests>
    {
      projects.map((project, index) => (
        <article class="quest" style={`--i:${index}`}>
          <h3 class="quest__heading">
            <button
              class="quest__tab"
              type="button"
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`quest-${project.key}`}
              data-quest-tab
            >
              <span class="quest__name display">{project.name}</span>
              <span class="quest__summary">{project.summary}</span>
            </button>
          </h3>
          <div class:list={['quest__detail', { 'is-open': index === 0 }]} id={`quest-${project.key}`} data-quest-detail>
            <p class="quest__description">{project.description}</p>
            <ul class="quest__highlights">
              {project.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <ul class="quest__tech">
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {project.url && (
              <a class="quest__visit display" href={project.url} target="_blank" rel="noopener noreferrer">
                {t.projects.visit}
                <span class="sr-only">: {project.name}</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Panel>

<script>
  const wideLayout = window.matchMedia('(min-width: 900px)');

  document.querySelectorAll<HTMLElement>('[data-quests]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-quest-tab]'));

    function setOpen(tab: HTMLButtonElement, open: boolean) {
      const detail = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      tab.setAttribute('aria-expanded', String(open));
      detail?.classList.toggle('is-open', open);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const isOpen = tab.getAttribute('aria-expanded') === 'true';
        if (isOpen && wideLayout.matches) return;
        tabs.forEach((other) => setOpen(other, false));
        setOpen(tab, !isOpen);
      });
    });

    // The wide layout always shows one detail; keep one open when the window widens.
    wideLayout.addEventListener('change', () => {
      if (wideLayout.matches && !tabs.some((tab) => tab.getAttribute('aria-expanded') === 'true')) {
        setOpen(tabs[0], true);
      }
    });
  });
</script>

<style>
  .quests__remark {
    max-width: 40ch;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-lead);
    font-weight: 800;
    font-style: italic;
    line-height: 1.3;
  }

  .quests {
    display: grid;
    gap: 0.9rem;
  }

  .quest__heading {
    font: inherit;
  }

  .quest__tab {
    position: relative;
    display: grid;
    gap: 0.3rem;
    width: 100%;
    padding: 0.9rem 1.4rem 1rem;
    text-align: left;
    color: var(--p5-black);
    background: var(--p5-white);
    clip-path: polygon(0 0, 100% 6%, 98% 100%, 1% 92%);
    rotate: -1deg;
    isolation: isolate;
    transition: translate var(--t-snap) var(--ease-snap), rotate var(--t-snap) var(--ease-snap);
  }

  .quest:nth-child(even) .quest__tab {
    rotate: 0.8deg;
  }

  .quest__name {
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.6rem);
  }

  .quest__summary {
    font-size: var(--step-small);
    font-weight: 600;
    line-height: 1.35;
  }

  .quest__tab:hover {
    translate: 0.6rem 0;
  }

  .quest__tab[aria-expanded='true'] {
    color: var(--p5-white);
    background: var(--p5-black);
    translate: 1.2rem 0;
    rotate: -2.5deg;
  }

  .quest__tab:focus-visible {
    outline-offset: -8px;
    outline-color: var(--p5-red);
    box-shadow: none; /* taste-skill-ignore: removes the global focus halo here */
  }

  .quest__detail {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--p5-black);
    background: var(--p5-white);
    clip-path: polygon(1% 0, 100% 2%, 99% 100%, 0 98%);
  }

  html.js .quest__detail:not(.is-open) {
    display: none;
  }

  .quest__detail.is-open {
    animation: detail-in 420ms var(--ease-snap) both;
  }

  @keyframes detail-in {
    from {
      opacity: 0;
      translate: 2.5rem 0;
    }
  }

  .quest__description {
    max-width: 65ch;
  }

  .quest__highlights {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .quest__highlights li {
    position: relative;
    padding-left: 1.6rem;
  }

  .quest__highlights li::before {
    content: '';
    position: absolute;
    top: 0.3em;
    left: 0;
    width: 0.95rem;
    height: 0.95rem;
    background: var(--p5-red);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }

  .quest__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .quest__tech li {
    padding: 0.25em 0.7em;
    font-size: var(--step-small);
    font-weight: 800;
    color: var(--p5-white);
    background: var(--p5-black);
    clip-path: polygon(4% 0, 100% 0, 96% 100%, 0 100%);
  }

  .quest__visit {
    display: inline-flex;
    margin-top: 2rem;
    padding: 0.3em 0.9em 0.2em;
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--p5-white);
    background: var(--p5-red);
    clip-path: var(--slab);
    transition: rotate var(--t-snap) var(--ease-snap), scale var(--t-snap) var(--ease-snap);
  }

  .quest__visit:hover,
  .quest__visit:focus-visible {
    rotate: -4deg;
    scale: 1.06;
  }

  /* Wide screens with script: request list on the left, the open request on the right. */
  @media (min-width: 900px) {
    html.js .quests {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: repeat(6, auto) 1fr;
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    html.js .quest {
      display: contents;
    }

    html.js .quest__heading {
      grid-column: 1;
    }

    html.js .quest__detail {
      grid-column: 2;
      grid-row: 1 / -1;
      rotate: 1deg;
    }
  }

  @media (max-width: 899px) {
    .quest__tab[aria-expanded='true'] {
      translate: 0.4rem 0;
      rotate: -1.5deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quest__detail.is-open {
      animation: none;
    }
  }
</style>
