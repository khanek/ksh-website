---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: string;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = await import(`../i18n/${lang}.json`);

const otherLang = lang === 'en' ? 'pl' : 'en';
const otherLangPath = lang === 'en' ? '/pl' : '/';

const sections = [
  { id: 'about', label: t.about.title },
  { id: 'projects', label: t.projects.title },
  { id: 'skills', label: t.skills.title },
  { id: 'contact', label: t.contact.title },
];
---

<header>
  <nav class="container">
    <div class="nav-content">
      <a href={lang === 'en' ? '/' : '/pl'} class="logo">
        <span class="logo-mark">KH</span>
        <span class="logo-name">Hanek Software</span>
      </a>
      
      <ul class="section-nav-list">
        {sections.map((section) => (
          <li>
            <a 
              href={`#${section.id}`} 
              class="section-nav-link"
              data-section={section.id}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ul>
      
      <div class="nav-right">
        <div class="language-switcher">
          <a 
            href={otherLangPath}
            class={currentPath === otherLangPath ? 'active' : ''}
            aria-label={lang === 'pl' ? 'Przełącz na język angielski' : 'Switch to Polish'}
          >
            {otherLang.toUpperCase()}
          </a>
        </div>
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </nav>
</header>

<script>
  // Scroll spy implementation
  function initScrollSpy() {
    const links = document.querySelectorAll('.section-nav-link');
    const sections = Array.from(links).map(link => {
      const id = link.getAttribute('data-section');
      return document.getElementById(id);
    }).filter(Boolean);

    if (sections.length === 0) return;

    let ticking = false;
    let isScrollingProgrammatically = false;
    let scrollTimeout: number | null = null;

    function setActiveLink(sectionId: string) {
      links.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-section') === sectionId) {
          link.classList.add('active');
        }
      });
    }

    function updateActiveLink() {
      if (isScrollingProgrammatically) {
        ticking = false;
        return;
      }

      const headerHeight = 70;
      const scrollPos = window.scrollY + headerHeight + 50;

      let currentSection = '';
      
      for (let i = sections.length - 1; i >= 0; i--) {
        const section = sections[i];
        const sectionTop = section.offsetTop;
        
        if (scrollPos >= sectionTop) {
          currentSection = section.id;
          break;
        }
      }

      if (!currentSection && window.scrollY < 200) {
        currentSection = sections[0]?.id || '';
      }

      if (currentSection) {
        setActiveLink(currentSection);
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateActiveLink);
        ticking = true;
      }

      if (scrollTimeout) {
        clearTimeout(scrollTimeout);
      }
      scrollTimeout = window.setTimeout(() => {
        isScrollingProgrammatically = false;
        updateActiveLink();
      }, 100);
    }

    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('data-section');
        const target = document.getElementById(targetId);
        
        if (target) {
          setActiveLink(targetId);
          isScrollingProgrammatically = true;
          
          const headerHeight = 70;
          const targetPosition = target.offsetTop - headerHeight;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });

          setTimeout(() => {
            isScrollingProgrammatically = false;
            updateActiveLink();
          }, 800);
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    updateActiveLink();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy);
  } else {
    initScrollSpy();
  }

  document.addEventListener('astro:page-load', initScrollSpy);
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: var(--header-height);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(18px);
  }
  
  nav {
    padding-block: 0;
  }
  
  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-height);
    gap: var(--spacing-md);
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text);
    flex-shrink: 0;
  }

  .logo-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.06em;
    transition: transform 0.2s ease;
  }

  .logo-name {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .logo:hover {
    color: var(--color-text);
  }

  .logo:hover .logo-mark {
    transform: rotate(-4deg);
  }

  .section-nav-list {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .section-nav-list::-webkit-scrollbar {
    display: none;
  }

  .section-nav-list li {
    flex-shrink: 0;
  }

  .section-nav-link {
    display: block;
    padding: 1.7rem 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .section-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .section-nav-link:hover {
    color: var(--color-text);
  }

  .section-nav-link.active {
    color: var(--color-accent);
  }

  .section-nav-link.active::after {
    transform: scaleX(1);
  }
  
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  
  .language-switcher a {
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  
  .language-switcher a:hover {
    color: var(--color-text);
    background: var(--color-surface);
    border-color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .section-nav-list {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .logo-name {
      display: none;
    }
  }
  
  @media print {
    header {
      display: none !important;
    }
  }
</style>
